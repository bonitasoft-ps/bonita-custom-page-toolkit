{
  "name": "angular-directory-bonita",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bonita custom page (Angular) deployed as the 'home' page of the appDirectoryBonitaAngular application",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration=production",
    "build:bonita": "ng build --configuration=production && cross-env DIST_DIR=dist/angular-directory-bonita/browser node scripts/package-bonita.js",
    "dist": "npm run build:bonita && node scripts/copy-docs.js",
    "watch": "ng build --watch --configuration=development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.7.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/node": "^22.0.0",
    "archiver": "^7.0.0",
    "cross-env": "^7.0.3",
    "typescript": "~5.5.0",
    "@angular-eslint/eslint-plugin": "^18.0.0",
    "@angular-eslint/eslint-plugin-template": "^18.0.0",
    "@angular-eslint/template-parser": "^18.0.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/angular": "^17.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.0",
    "jest-preset-angular": "^14.2.0",
    "jest": "^29.7.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "msw": "^2.6.0",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,svelte,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
